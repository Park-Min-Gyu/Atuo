# ── 필수: API 키 ────────────────────────────────────────────────────────────
# Gemini 키: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude 키 (선택): https://console.anthropic.com → API Keys
# 비워 두면 Gemini 만으로 동작합니다. claude.ai 구독(Pro/Max)과는 별개로,
# API 는 쓴 만큼 따로 과금되는 키가 필요합니다.
ANTHROPIC_API_KEY=

# ── 서버 ────────────────────────────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1
# 설정하면 모든 요청에 Authorization: Bearer <값> 이 필요합니다.
# HOST 를 0.0.0.0 으로 열 때는 반드시 설정하세요.
ROUTER_API_KEY=

# ── 모델 ────────────────────────────────────────────────────────────────────
GEMINI_CHEAP_MODEL=gemini-2.5-flash
GEMINI_MID_MODEL=gemini-2.5-pro
# cheap 요청에 붙이는 생각(추론) 강도. 생각 토큰도 출력 요금이라 low 가 절약됩니다. off = 모델 기본값
GEMINI_CHEAP_EFFORT=low
# 더 아끼려면 claude-sonnet-5-5 또는 claude-haiku-5-5
ROUTER_CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (비우면 모델 기본값)
ROUTER_CLAUDE_EFFORT=

# ── 토큰 절약 ───────────────────────────────────────────────────────────────
# Claude 하루 토큰 한도(입력+출력). 넘으면 그날은 Gemini 로만 보냅니다. 0 = 제한 없음
ROUTER_CLAUDE_DAILY_TOKEN_BUDGET=0
# 자동 분류 점수 기준. 숫자를 올릴수록 싼 모델로 더 많이 갑니다.
ROUTE_MID_THRESHOLD=2
ROUTE_SMART_THRESHOLD=4
# off | lossless | standard | aggressive
COMPRESSION=standard
# aggressive 에서 대화가 이 토큰 수를 넘으면 오래된 부분을 싼 모델로 요약합니다.
HISTORY_TOKEN_BUDGET=24000
# 같은 요청은 저장된 답을 돌려줍니다 (토큰 0).
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
# 모든 응답의 출력 토큰 상한. 0 = 제한 없음
MAX_OUTPUT_TOKENS=0
# 한 모델이 실패하면 다음 모델로 넘어갈지
FALLBACK=true
