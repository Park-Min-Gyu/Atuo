# 이 파일을 .env 로 복사한 뒤 키를 넣으세요. (.env 는 git에 올라가지 않습니다)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# 선택 설정 --------------------------------------------------
# DUO_CLAUDE_MODEL=claude-opus-5-5
# DUO_GEMINI_MODEL=gemini-3.8-flash
# DUO_CLAUDE_EFFORT=low          # low | medium | high | xhigh | max
# DUO_HARD_SCORE=3               # 낮출수록 Claude를 더 자주 씁니다
# DUO_ESCALATE=1                 # Gemini가 자신 없으면 Claude로 넘김
# DUO_FALLBACK=1                 # 한쪽이 실패하면 다른 쪽으로 재시도
# DUO_COMPRESS_AFTER_TOKENS=6000 # 대화가 이보다 길어지면 요약 압축
# DUO_KEEP_RECENT_TURNS=4
# DUO_CACHE=1
# DUO_GEMINI_INPUT_PRICE=        # USD / 100만 토큰 (넣으면 절감액 계산)
# DUO_GEMINI_OUTPUT_PRICE=
